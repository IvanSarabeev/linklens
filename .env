# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=b85f0599e49f79c33b6cbff5539c2567
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL for links generated outside HTTP requests (CLI, workers, emails)
DEFAULT_URI=https://127.0.0.1:8000
###< symfony/routing ###

###> docker ###
# Dev-only credentials, read by compose.yaml and reused below.
# Must stay ABOVE every line that references them.
POSTGRES_DB=linklens
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
###< docker ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default
# P7: MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@127.0.0.1:5672/%2f/messages"
###< symfony/messenger ###

###> app ###
REDIS_URL=redis://127.0.0.1:6379
CHAOS_HOST=127.0.0.1:8090
SERVICE_NAME=linklens
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
TELEMETRY_EXPORTER=otlp
#TELEMETRY_EXPORTER=memory - local ping
# Dev-only value; production sets its own via `symfony console secrets:set IP_HASH_SECRET`
IP_HASH_SECRET=change-me
###< app ###

###> symfony/lock ###
LOCK_DSN="${REDIS_URL}"
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=smtp://127.0.0.1:1025
###< symfony/mailer ###
