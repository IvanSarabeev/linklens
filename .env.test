# Test-only defaults. Committed; personal overrides go in .env.test.local (gitignored).
# Loaded after .env when APP_ENV=test. Real environment variables (CI) still win.

KERNEL_CLASS='App\Kernel'

# Single quotes matter: unquoted, "$ecretf0rt3st" would be read as a variable and end up empty
APP_SECRET='$ecretf0rt3st'

# DATABASE_URL comes from .env; doctrine.yaml's dbname_suffix turns it into linklens_test

# Tests never send real mail; assert on sent messages instead
MAILER_DSN=null://null

# File-based locks, so tests and CI don't need Redis
LOCK_DSN=flock

# Fixed value, so hashed IPs are predictable in assertions
IP_HASH_SECRET=test-ip-hash-secret
